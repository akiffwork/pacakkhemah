rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- HELPER FUNCTIONS ---

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'akiff.work@gmail.com';
    }
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.owner_uid;
    }
    function isCreatingOwn() {
      return request.auth != null && request.resource.data.owner_uid == request.auth.uid;
    }
    function isVendorOwner(vendorId) {
       return request.auth != null &&
              get(/databases/$(database)/documents/vendors/$(vendorId)).data.owner_uid == request.auth.uid;
    }

    // --- 1. VENDORS COLLECTION ---
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isCreatingOwn();
      allow update: if isAdmin() || isOwner();
      allow delete: if isAdmin();

      match /discounts/{discountId} {
        allow read: if true;
        allow create, delete: if isVendorOwner(vendorId);
        allow update: if isVendorOwner(vendorId) ||
          // Customers can record discount usage after placing an order:
          // only usedCount and usedBy may change, and usedCount must increase by exactly 1.
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedCount', 'usedBy']) &&
           request.resource.data.usedCount == resource.data.usedCount + 1);
      }
      match /referrals/{referralId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
      match /availability/{ruleId} {
        allow read: if true;
        allow create: if isVendorOwner(vendorId) ||
                         request.resource.data.orderId != null;
        allow update, delete: if isVendorOwner(vendorId);
      }
      match /posts/{postId} {
        allow read: if true;
        allow create: if isVendorOwner(vendorId);
        allow update, delete: if isVendorOwner(vendorId);
      }
      match /foodPartners/{foodPartnerId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
      match /wizard/{docId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
    }

    // --- 2. GEAR COLLECTION ---
    match /gear/{gearId} {
      allow read: if true;
      allow create: if isCreatingOwn();
      allow update, delete: if isAdmin() || isVendorOwner(resource.data.vendorId);
    }

    // --- 3. CAMPSITES ---
    match /campsites/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 4. ANALYTICS ---
    match /analytics/{docId} {
      allow create: if true;
      allow read: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow update, delete: if isAdmin();
    }

    // --- 5. SETTINGS ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 6. EVENTS ---
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 7. AGREEMENTS ---
    match /agreements/{docId} {
      allow create: if true;
      allow read: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- 8. ORDERS COLLECTION ---
    match /orders/{orderId} {
      // Single-doc fetch by ID is allowed unauthenticated: the orderId is an
      // unguessable Firestore auto-ID, used as a bearer token for links like
      // the agreement-signing page (same trust model as reviewToken below).
      allow get: if true;
      // Listing/querying the collection (e.g. by customerPhone) must NOT be
      // open to everyone — that would let anyone dump every customer's PII.
      // Anonymous phone-lookup flows (my-bookings, shop "my booking" search)
      // go through the lookupBookingsByPhone Cloud Function instead.
      allow list: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow create: if true;
      allow update: if isAdmin() || isVendorOwner(resource.data.vendorId) ||
        // Customer marks their review link as used after submitting a review:
        // only reviewTokenUsed may change, and only to true, and the token
        // itself must be unchanged (prevents tampering with other fields).
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['reviewTokenUsed']) &&
         request.resource.data.reviewTokenUsed == true &&
         request.resource.data.reviewToken == resource.data.reviewToken);
      allow delete: if isAdmin();
    }

    // --- 9. REVIEWS COLLECTION ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.status == "published" &&
                       request.resource.data.isVerified == true &&
                       // Must correspond to a real, completed, not-yet-reviewed order,
                       // and the token must match — prevents forged "verified" reviews.
                       request.resource.data.reviewToken ==
                         get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.reviewToken &&
                       get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == "completed" &&
                       get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.reviewTokenUsed != true;
      allow update: if isAdmin() ||
                       (isVendorOwner(resource.data.vendorId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['vendorReply', 'vendorRepliedAt', 'status']));
      allow delete: if isAdmin();
    }

    // --- 10. CONFIG COLLECTION ---
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 11. TRANSACTIONS COLLECTION ---
    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- 12. TESTIMONIALS COLLECTION ---
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 13. ARTICLES (Camping Guide) ---
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isAdmin() || request.auth != null;
      allow update, delete: if isAdmin() || isVendorOwner(resource.data.authorId);
    }

    // --- 14. WIZARD SESSIONS ---
    match /wizardSessions/{sessionId} {
      allow create: if true;
      allow update: if true;
      allow read, delete: if isAdmin();
    }
  }
}
