rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- HELPER FUNCTIONS ---

    // The owner is always an admin; extra admins are listed in private/admins
    // (Admin › Settings › Admin access).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'akiff.work@gmail.com' ||
        (request.auth.token.email_verified == true &&
         exists(/databases/$(database)/documents/private/admins) &&
         request.auth.token.email.lower() in get(/databases/$(database)/documents/private/admins).data.emails)
      );
    }
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.owner_uid;
    }
    function isCreatingOwn() {
      return request.auth != null && request.resource.data.owner_uid == request.auth.uid;
    }
    function isVendorOwner(vendorId) {
       return request.auth != null &&
              get(/databases/$(database)/documents/vendors/$(vendorId)).data.owner_uid == request.auth.uid;
    }

    // Fields only the admin or Cloud Functions may change: credits are paid
    // for, referral rewards are granted on approval, and status is approval.
    function startingCredits() {
      let cfg = /databases/$(database)/documents/settings/payment_config;
      return exists(cfg) ? get(cfg).data.get('startingCredits', 10) : 10;
    }
    function touchesProtectedVendorFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'credits', 'status',
        'referral_total_credits', 'referral_total_referred',
        'referralRewarded', 'referralRewardedAt'
      ]);
    }

    // --- 1. VENDORS COLLECTION ---
    match /vendors/{vendorId} {
      allow read: if true;
      // A new shop starts pending, with no more than the free starting credits
      allow create: if isAdmin() || (isCreatingOwn() &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        request.resource.data.get('credits', 0) is number &&
        request.resource.data.get('credits', 0) <= startingCredits() &&
        request.resource.data.get('referralRewarded', false) == false &&
        !request.resource.data.keys().hasAny([
          'referral_total_credits', 'referral_total_referred', 'referralRewardedAt'
        ]));
      allow update: if isAdmin() || (isOwner() && !touchesProtectedVendorFields());
      allow delete: if isAdmin();

      match /discounts/{discountId} {
        allow read: if true;
        allow create, delete: if isVendorOwner(vendorId);
        allow update: if isVendorOwner(vendorId) ||
          // Customers can record discount usage after placing an order:
          // only usedCount and usedBy may change, and usedCount must increase by exactly 1.
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedCount', 'usedBy']) &&
           request.resource.data.usedCount == resource.data.usedCount + 1);
      }
      match /referrals/{referralId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
      match /availability/{ruleId} {
        allow read: if true;
        allow create: if isVendorOwner(vendorId) ||
                         request.resource.data.orderId != null;
        allow update, delete: if isVendorOwner(vendorId) || isAdmin();
      }
      match /posts/{postId} {
        allow read: if true;
        allow create: if isVendorOwner(vendorId);
        allow update, delete: if isVendorOwner(vendorId);
      }
      match /foodPartners/{foodPartnerId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
      match /wizard/{docId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
    }

    // --- 1b. CREDIT TOP-UPS (bank QR, approved by the admin) ---
    // A vendor may only file a pending request for their own shop. Only the
    // admin approves or rejects; approval is what adds credits.
    match /topups/{topupId} {
      allow read: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow create: if isAdmin() || (
        isVendorOwner(request.resource.data.vendorId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.credits is int && request.resource.data.credits > 0 &&
        request.resource.data.price is number && request.resource.data.price > 0 &&
        request.resource.data.reference is string && request.resource.data.reference.size() <= 20 &&
        request.resource.data.keys().hasOnly([
          'vendorId', 'vendorName', 'uid', 'credits', 'price', 'reference',
          'status', 'receiptUrl', 'receiptPath', 'createdAt'
        ]));
      allow update, delete: if isAdmin();
    }

    // --- 2. GEAR COLLECTION ---
    match /gear/{gearId} {
      allow read: if true;
      allow create: if isCreatingOwn();
      allow update, delete: if isAdmin() || isVendorOwner(resource.data.vendorId);
    }

    // --- 3. CAMPSITES ---
    match /campsites/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 4. ANALYTICS ---
    match /analytics/{docId} {
      allow create: if true;
      allow read: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow update, delete: if isAdmin();
    }

    // --- 5. SETTINGS ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 5b. PRIVATE (admin-only documents, e.g. the admin list) ---
    match /private/{docId} {
      allow read, write: if isAdmin();
    }

    // --- 6. EVENTS ---
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 7. AGREEMENTS ---
    function isStrMax(v, n) { return v is string && v.size() <= n; }
    function optStrMax(d, k, n) { return !(k in d) || d[k] == null || isStrMax(d[k], n); }
    function validAgreement(d) {
      return d.keys().hasOnly([
               'vendorId', 'customerName', 'customerPhone', 'idType', 'idNumber', 'orderId',
               'rentalSummary', 'vendorTerms', 'generalTerms', 'customerSignature',
               'customerSignedAt', 'vendorSignedAt', 'verificationCode', 'timestamp', 'status', 'userAgent'])
        && d.keys().hasAll(['vendorId', 'customerName', 'customerPhone', 'idNumber', 'customerSignature', 'timestamp', 'status'])
        && isStrMax(d.vendorId, 64) && exists(/databases/$(database)/documents/vendors/$(d.vendorId))
        && isStrMax(d.customerName, 120) && d.customerName.size() > 0
        && isStrMax(d.customerPhone, 20)
        && (!('idType' in d) || d.idType in ['ic', 'passport'])
        && isStrMax(d.idNumber, 20) && d.idNumber.size() >= 6
        && isStrMax(d.customerSignature, 120) && d.customerSignature.size() > 0
        && d.status == 'signed'
        && d.timestamp == request.time
        && optStrMax(d, 'customerSignedAt', 40) && optStrMax(d, 'vendorSignedAt', 40)
        && optStrMax(d, 'verificationCode', 24) && optStrMax(d, 'userAgent', 400)
        && (!('vendorTerms' in d) || (d.vendorTerms is list && d.vendorTerms.size() <= 100))
        && (!('generalTerms' in d) || (d.generalTerms is list && d.generalTerms.size() <= 20))
        && (!('rentalSummary' in d) || d.rentalSummary == null || d.rentalSummary is map)
        && (!('orderId' in d) || d.orderId == null
            || (isStrMax(d.orderId, 64)
                && exists(/databases/$(database)/documents/orders/$(d.orderId))
                && get(/databases/$(database)/documents/orders/$(d.orderId)).data.vendorId == d.vendorId));
    }

    match /agreements/{docId} {
      // Customers sign without an account, so creation stays open, but only
      // a well-formed agreement for a real vendor (and, when given, an order
      // of that vendor) is accepted. Limits keep junk and huge docs out.
      allow create: if validAgreement(request.resource.data);
      allow read: if isAdmin() || isVendorOwner(resource.data.vendorId);
      // The signed content never changes. The owning vendor may only set or
      // clear which of their own orders it is linked to.
      allow update: if isVendorOwner(resource.data.vendorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderId', 'linkSkipped', 'requestedOrderId'])
        && (request.resource.data.orderId == null
            || (request.resource.data.orderId is string
                && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.vendorId == resource.data.vendorId));
      allow delete: if isAdmin();
    }

    // --- 8. ORDERS COLLECTION ---
    match /orders/{orderId} {
      // Single-doc fetch by ID is allowed unauthenticated: the orderId is an
      // unguessable Firestore auto-ID, used as a bearer token for links like
      // the agreement-signing page (same trust model as reviewToken below).
      allow get: if true;
      // Listing/querying the collection (e.g. by customerPhone) must NOT be
      // open to everyone — that would let anyone dump every customer's PII.
      // Anonymous phone-lookup flows (my-bookings, shop "my booking" search)
      // go through the lookupBookingsByPhone Cloud Function instead.
      allow list: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow create: if true;
      allow update: if isAdmin() || isVendorOwner(resource.data.vendorId) ||
        // Customer marks their review link as used after submitting a review:
        // only reviewTokenUsed may change, and only to true, and the token
        // itself must be unchanged (prevents tampering with other fields).
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['reviewTokenUsed']) &&
         request.resource.data.reviewTokenUsed == true &&
         request.resource.data.reviewToken == resource.data.reviewToken);
      allow delete: if isAdmin();
    }

    // --- 9. REVIEWS COLLECTION ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.status == "published" &&
                       request.resource.data.isVerified == true &&
                       // Must correspond to a real, completed, not-yet-reviewed order,
                       // and the token must match — prevents forged "verified" reviews.
                       request.resource.data.reviewToken ==
                         get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.reviewToken &&
                       get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == "completed" &&
                       get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.reviewTokenUsed != true;
      allow update: if isAdmin() ||
                       (isVendorOwner(resource.data.vendorId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['vendorReply', 'vendorRepliedAt', 'status']));
      allow delete: if isAdmin();
    }

    // --- 10. CONFIG COLLECTION ---
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 11. TRANSACTIONS COLLECTION ---
    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- 12. TESTIMONIALS COLLECTION ---
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 13. ARTICLES (Camping Guide) ---
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isAdmin() || request.auth != null;
      allow update, delete: if isAdmin() || isVendorOwner(resource.data.authorId);
    }

    // --- 14. WIZARD SESSIONS ---
    match /wizardSessions/{sessionId} {
      allow create: if true;
      allow update: if true;
      allow read, delete: if isAdmin();
    }

    // --- 15. PROSPECT VENDORS (not yet registered) ---
    // Public read so the directory can list them in empty areas. Keep only
    // public business info here (name, public business number, area).
    match /prospects/{prospectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 16. PROSPECT CLICKS (customer enquiries sent to prospects) ---
    // Anonymous create with a strict shape; only admin can read.
    match /prospect_clicks/{clickId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['prospectId', 'searched', 'state', 'district', 'pickupDate',
                          'returnDate', 'pax', 'items', 'createdAt']) &&
                       request.resource.data.prospectId is string &&
                       request.resource.data.prospectId.size() < 64 &&
                       exists(/databases/$(database)/documents/prospects/$(request.resource.data.prospectId)) &&
                       request.resource.data.searched is string &&
                       request.resource.data.searched.size() <= 80 &&
                       (!('pax' in request.resource.data) || request.resource.data.pax == null ||
                        (request.resource.data.pax is int && request.resource.data.pax >= 1 && request.resource.data.pax <= 100)) &&
                       (!('items' in request.resource.data) ||
                        (request.resource.data.items is list && request.resource.data.items.size() <= 10)) &&
                       request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // --- 17. AREA WAITLIST (customers waiting for a vendor in their area) ---
    // Holds customer phone numbers, so read is admin-only.
    match /area_waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['phone', 'searched', 'state', 'district', 'createdAt']) &&
                       request.resource.data.phone is string &&
                       request.resource.data.phone.matches('^60[0-9]{8,11}$') &&
                       request.resource.data.searched is string &&
                       request.resource.data.searched.size() <= 80 &&
                       request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
