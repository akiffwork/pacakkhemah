rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Vendors ──────────────────────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.owner_uid;

      match /discounts/{id}   { allow read: if true; allow write: if isVendorOwner(vendorId); }
      match /availability/{id}{ allow read: if request.auth != null; allow write: if isVendorOwner(vendorId); }
      match /referrals/{id}   { allow read: if true; allow write: if isVendorOwner(vendorId); }
      match /foodPartners/{id}{ allow read: if true; allow write: if isVendorOwner(vendorId); }
      match /transactions/{id}{ allow read: if isVendorOwner(vendorId); allow write: if request.auth != null; }
    }

    // ── Gear ─────────────────────────────────────────────────────────────────
    match /gear/{gearId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Orders ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;   // customer creates on checkout
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reviewTokenUsed']); // allow review form to mark token used
    }

    // ── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;   // review form is unauthenticated; token validates client-side
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['vendorReply', 'vendorRepliedAt', 'status']);
    }

    // ── Analytics ────────────────────────────────────────────────────────────
    match /analytics/{docId} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    // ── Agreements ───────────────────────────────────────────────────────────
    match /agreements/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
    }

    // ── Campsites ────────────────────────────────────────────────────────────
    match /campsites/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Helper ───────────────────────────────────────────────────────────────
    function isVendorOwner(vendorId) {
      return request.auth != null
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.owner_uid == request.auth.uid;
    }
  }
}
