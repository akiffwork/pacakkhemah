rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- HELPER FUNCTIONS ---

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'akiff.work@gmail.com';
    }
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.owner_uid;
    }
    function isCreatingOwn() {
      return request.auth != null && request.resource.data.owner_uid == request.auth.uid;
    }
    function isVendorOwner(vendorId) {
       return request.auth != null &&
              get(/databases/$(database)/documents/vendors/$(vendorId)).data.owner_uid == request.auth.uid;
    }

    // --- 1. VENDORS COLLECTION ---
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isCreatingOwn();
      allow update: if isAdmin() || isOwner();
      allow delete: if isAdmin();

      match /discounts/{discountId} {
        allow read: if true;
        allow create, delete: if isVendorOwner(vendorId);
        allow update: if isVendorOwner(vendorId) ||
          // Customers can record discount usage after placing an order:
          // only usedCount and usedBy may change, and usedCount must increase by exactly 1.
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedCount', 'usedBy']) &&
           request.resource.data.usedCount == resource.data.usedCount + 1);
      }
      match /referrals/{referralId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
      match /availability/{ruleId} {
        allow read: if true;
        allow create: if isVendorOwner(vendorId) ||
                         request.resource.data.orderId != null;
        allow update, delete: if isVendorOwner(vendorId);
      }
      match /posts/{postId} {
        allow read: if true;
        allow create: if isVendorOwner(vendorId);
        allow update, delete: if isVendorOwner(vendorId);
      }
      match /foodPartners/{foodPartnerId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isVendorOwner(vendorId);
      }
    }

    // --- 2. GEAR COLLECTION ---
    match /gear/{gearId} {
      allow read: if true;
      allow create: if isCreatingOwn();
      allow update, delete: if isAdmin() || isVendorOwner(resource.data.vendorId);
    }

    // --- 3. CAMPSITES ---
    match /campsites/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 4. ANALYTICS ---
    match /analytics/{docId} {
      allow create: if true;
      allow read: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow update, delete: if isAdmin();
    }

    // --- 5. SETTINGS ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 6. EVENTS ---
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 7. AGREEMENTS ---
    match /agreements/{docId} {
      allow create: if true;
      allow read: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- 8. ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || isVendorOwner(resource.data.vendorId);
      allow delete: if isAdmin();
    }

    // --- 9. REVIEWS COLLECTION ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.isVerified == true &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.status == "published";
      allow update: if isAdmin() ||
                       (isVendorOwner(resource.data.vendorId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['vendorReply', 'vendorRepliedAt', 'status']));
      allow delete: if isAdmin();
    }

    // --- 10. CONFIG COLLECTION ---
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 11. TRANSACTIONS COLLECTION ---
    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- 12. TESTIMONIALS COLLECTION ---
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
