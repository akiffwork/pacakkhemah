rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // HELPER: Check if user is the specific Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'akiff.work@gmail.com';
    }

    // HELPER: Check if user owns the vendor doc (cross-service read into Firestore)
    function isVendorOwner(vendorId) {
      return request.auth != null &&
             firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.owner_uid == request.auth.uid;
    }

    // 1. VENDOR LOGOS
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 2. GEAR IMAGES
    match /gear/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 3. EVENTS (Admin Only)
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 4. CAMPSITES (Admin Only)
    match /campsites/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 5. CUSTOMER VERIFICATIONS (IC/Passport Uploads)
    // Read is restricted to the admin or the vendor that owns this booking —
    // these are government ID photos and must not be readable by any other
    // signed-in account. Write stays open (unauthenticated customers upload
    // these during the no-login agreement-signing flow).
    match /verifications/{vendorId}/{allPaths=**} {
      allow read: if isAdmin() || isVendorOwner(vendorId);
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 6. FOOD PARTNER IMAGES
    match /foodPartners/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 7. REVIEW PHOTOS (unauthenticated — customer review form is public)
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 8. ARTICLE COVER IMAGES (public read, authenticated write)
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
