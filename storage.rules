rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // HELPER: Check if user is the specific Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'akiff.work@gmail.com' ||
        (request.auth.token.email_verified == true &&
         firestore.exists(/databases/(default)/documents/private/admins) &&
         request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/private/admins).data.emails)
      );
    }

    // HELPER: Check if user owns the vendor doc (cross-service read into Firestore)
    function isVendorOwner(vendorId) {
      return request.auth != null &&
             firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.owner_uid == request.auth.uid;
    }

    function isImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    // 1. VENDOR LOGOS (logos/{vendorId}): only that shop's owner or the admin
    match /logos/{allPaths=**} {
      allow read: if true;
    }
    match /logos/{vendorId} {
      allow write: if (isAdmin() || isVendorOwner(vendorId)) && isImageUpload();
    }

    // 2. GEAR IMAGES (gear/{vendorId}/...): only that shop's owner or the admin
    match /gear/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isVendorOwner(vendorId)) && isImageUpload();
    }

    // 3. EVENTS (Admin Only)
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 4. CAMPSITES (Admin Only)
    match /campsites/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 5. CUSTOMER VERIFICATIONS (older agreements' IC photos)
    // The agreement form now asks for an IC / passport NUMBER instead of
    // photos, so no new uploads are accepted. Existing photos stay readable
    // only by the admin or the vendor that owns the booking.
    match /verifications/{vendorId}/{allPaths=**} {
      allow read: if isAdmin() || isVendorOwner(vendorId);
      allow write: if false;
    }

    // 6. FOOD PARTNER IMAGES
    match /foodPartners/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isVendorOwner(vendorId)) && isImageUpload();
    }

    // 7. REVIEW PHOTOS (unauthenticated — customer review form is public)
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 7b. SITE IMAGES (admin only, e.g. the payment QR)
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 7c. FREE DOWNLOADS (admin only): the shared files and their covers
    match /downloads/files/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|application/zip|application/epub[+]zip|application/msword|application/vnd[.]ms-excel|application/vnd[.]ms-powerpoint|application/vnd[.]openxmlformats-officedocument[.].*|image/.*');
      allow delete: if isAdmin();
    }
    match /downloads/covers/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUpload();
      allow delete: if isAdmin();
    }

    // 8. CREDIT TOP-UP RECEIPTS (private: the vendor and the admin)
    match /receipts/{vendorId}/{fileName} {
      allow read: if isAdmin() || isVendorOwner(vendorId);
      allow create: if isVendorOwner(vendorId)
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow update, delete: if isAdmin();
    }

    // 9. ARTICLE IMAGES (public read). Vendors write under articles/{vendorId}/,
    // the admin anywhere (admin pages use articles/<file> and articles/admin/).
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageUpload();
    }
    match /articles/{vendorId}/{rest=**} {
      allow write: if isVendorOwner(vendorId) && isImageUpload();
    }
  }
}
